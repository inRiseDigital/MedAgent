# ============================================================================
# Compose-level variables — copy to .env and adjust for LOCAL DEV ONLY.
# Dummy values only in this template (10 §5: no secrets in .env files, ever;
# gitleaks + GitHub push protection enforce). Shared-dev/staging/pilot values
# are SOPS-encrypted in infra/secrets/{env}.enc.yaml and injected at deploy.
# ============================================================================

# --- Postgres (per-service roles created by initdb/01-databases.sh) ---------
POSTGRES_SUPERUSER_PASSWORD=dev-superuser-pw
CORE_API_DB_PASSWORD=dev-core-api-pw
AGENT_SERVICE_DB_PASSWORD=dev-agent-service-pw
NOTIFY_SERVICE_DB_PASSWORD=dev-notify-service-pw
HAPI_DB_PASSWORD=dev-hapi-pw
KEYCLOAK_DB_PASSWORD=dev-keycloak-pw

# --- Redis ACL users (must match infra/compose/redis/users.acl in dev) ------
CORE_API_REDIS_PASSWORD=dev-core-api-redis-pw
AGENT_SERVICE_REDIS_PASSWORD=dev-agent-service-redis-pw
NOTIFY_SERVICE_REDIS_PASSWORD=dev-notify-service-redis-pw

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-admin-pw

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=dev-minio-root
MINIO_ROOT_PASSWORD=dev-minio-root-pw

# --- Face webhook HMAC (dual-key rotation via X-MedAgent-Key-Id, 05 §3) ------
FACE_WEBHOOK_HMAC_KEY_ID=dev-key-1
FACE_WEBHOOK_HMAC_SECRET=dev-face-webhook-secret

# --- Seed job ----------------------------------------------------------------
SEED_CLIENT_SECRET=dev-seed-client-secret

# --- Grafana (observability profile) ------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-grafana-pw
