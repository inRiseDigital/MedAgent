user default on nopass ~none +ping
user core-api on >dev-core-api-redis-pw ~core:* ~queue:* ~rate:* ~consent:* ~authz:* ~face:* &events:checkin:* &events:consent:* +@read +@write +@keyspace +@pubsub +ping -@admin -@dangerous
user agent-service on >dev-agent-service-redis-pw ~agent:* ~consent:* &events:consent:* +@read +@write +@keyspace +@pubsub +ping -@admin -@dangerous
user notify-service on >dev-notify-service-redis-pw ~notify:* ~sse:ticket:* &events:checkin:* &events:user:* &events:consent:* +@read +@write +@keyspace +@pubsub +ping -@admin -@dangerous
