# web (Next.js) env — template only, dummy values (10 §5).
# NEXT_PUBLIC_* values are non-secret by definition; anything secret here is
# server-side only and SOPS-injected in real environments.
NEXT_PUBLIC_API_BASE_URL=https://localhost/api
NEXT_PUBLIC_KEYCLOAK_URL=https://localhost/auth
NEXT_PUBLIC_KEYCLOAK_REALM=medagent
AUTH_SECRET=changeme-dummy
