# agent-service env — template only, dummy values (10 §5).
# Real environments: rendered from SOPS (infra/secrets/{env}.enc.yaml) at deploy.
# The Anthropic key is held ONLY by agent-service (10 §5); dev uses the scoped
# low-limit key from the vault (10 §2.4) — never a production-billing key.
ANTHROPIC_API_KEY=changeme-dummy
KEYCLOAK_CLIENT_ID=agent-service
KEYCLOAK_CLIENT_SECRET=changeme-dummy
