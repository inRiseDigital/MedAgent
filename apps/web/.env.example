# ─── apps/web environment ──────────────────────────────────────────────────
# Copy to .env.local for local dev. DUMMY VALUES ONLY in this file — real
# secrets live in the SOPS vault (docs/solution/10 §5); never commit them.

# ── Public (NEXT_PUBLIC_* is inlined into the browser bundle) ──────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# notify-service SSE stream endpoint — the browser connects here directly
# with a single-use ticket (docs/solution/02 §11); via gateway in staging+.
NEXT_PUBLIC_NOTIFY_STREAM_URL=http://localhost:8003/notify/stream

# ── Server-side only (BFF — never exposed to the browser, 06 §2.2) ─────────
# Keycloak confidential client (Authorization Code + PKCE, 02 §4)
KEYCLOAK_ISSUER=http://localhost:8080/realms/medagent
KEYCLOAK_CLIENT_ID=medagent-web
KEYCLOAK_CLIENT_SECRET=dev-dummy-not-a-real-secret
# Encrypts the server-side session record keyed by the __Host-session cookie.
SESSION_SECRET=dev-dummy-32char-session-secret!!
# Redis backing for encrypted sessions (06 §2.2) — wired in S2.
SESSION_REDIS_URL=redis://localhost:6379/1

# Service base URLs used by BFF routes / server components via @medagent/ts-sdk
CORE_API_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
NOTIFY_SERVICE_URL=http://localhost:8003

# Single-hospital pilot facility (S1). TODO(S2): derive from the staff member's
# Keycloak facility claim so a clinician only sees their own facility's queue.
PILOT_FACILITY_ID=pilot-hospital-1
