<?xml version="1.0" encoding="UTF-8"?>
<!--
  MedAgent FHIR interceptors — one audited Java module (03 §5).
  Built as a plain JAR dropped onto the HAPI starter classpath
  (/app/extra-classes, see ../Dockerfile). HAPI artifacts are `provided`
  because the starter image supplies them at runtime — bundling our own
  copies would risk classpath version skew against the pinned server.

  Build: mvn -B package   (see ../README.md)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>lk.medagent</groupId>
  <artifactId>medagent-fhir-interceptors</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>MedAgent FHIR Interceptors</name>
  <description>Authorisation, consent and audit interceptors for the MedAgent HAPI FHIR server (docs/solution/03 §5)</description>

  <properties>
    <!-- Must match the pinned server image tag in ../Dockerfile (hapiproject/hapi:v8.10.0-3). -->
    <hapi.version>8.10.0</hapi.version>
    <junit.version>5.10.2</junit.version>
    <mockito.version>5.11.0</mockito.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Provided by the HAPI starter image at runtime — never shaded in. -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-server</artifactId>
      <version>${hapi.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r4</artifactId>
      <version>${hapi.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Storage-layer pointcuts (STORAGE_PRECOMMIT_*, TransactionDetails). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-storage</artifactId>
      <version>${hapi.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
