# notify-service — example environment. DUMMY VALUES ONLY (policy: 10 §5).
# Stateless service: Redis only, no database.

REDIS_URL=redis://redis:6379/0
KEYCLOAK_ISSUER=https://localhost/auth/realms/medagent

# Local bootstrapping only — NEVER true in staging/pilot.
AUTH_DISABLED=false

# SSE stream behaviour (02 §11).
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_AGE_SECONDS=900

# Email adapter (mailpit in dev, 10 §2.1).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@medagent.local

LOG_LEVEL=INFO
