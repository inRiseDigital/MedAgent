# agent-service — example environment. DUMMY VALUES ONLY (policy: 10 §5).
# The Anthropic key is held ONLY by agent-service (10 §5 least privilege) and
# is injected from the vault — never committed.

DATABASE_URL=postgresql://agent_service:dummy-password@postgres:5432/app_db
REDIS_URL=redis://redis:6379/0
FHIR_BASE_URL=http://fhir:8080/fhir
KEYCLOAK_ISSUER=https://localhost/auth/realms/medagent
CORE_API_BASE_URL=http://core-api:8000

# Local bootstrapping only — NEVER true in staging/pilot.
AUTH_DISABLED=false

# Anthropic API (04 §4). Model pin is explicit and verified at startup in S3.
ANTHROPIC_API_KEY=sk-ant-dummy-not-a-real-key
ANTHROPIC_MODEL=claude-sonnet-5

LOG_LEVEL=INFO
