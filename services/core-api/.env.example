# core-api — example environment. DUMMY VALUES ONLY (policy: 10 §5 — no secrets in .env files).
# Real values are injected at deploy time from the SOPS vault.

DATABASE_URL=postgresql+asyncpg://core_api:dummy-password@postgres:5432/app_db
REDIS_URL=redis://redis:6379/0
FHIR_BASE_URL=http://fhir:8080/fhir
KEYCLOAK_ISSUER=https://localhost/auth/realms/medagent

# Local bootstrapping only — NEVER true in staging/pilot.
AUTH_DISABLED=false

# Dual-key HMAC secrets for the face-service webhook (05 §3), keyed by X-MedAgent-Key-Id.
FACE_WEBHOOK_HMAC_KEYS={"key-2026-01":"dummy-secret-a","key-2026-02":"dummy-secret-b"}

# Facility-level threshold policy is admin config (FR-6.2); env default for S1.
FACE_CONFIDENCE_THRESHOLD=0.85
FACE_WEBHOOK_TOLERANCE_SECONDS=300

SSE_TICKET_TTL_SECONDS=30
LOG_LEVEL=INFO
